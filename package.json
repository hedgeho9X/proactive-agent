{
  "name": "proactive-agent",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "bun run build:runtime && bun test",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write src tests scripts package.json tsconfig.json",
    "format:check": "prettier --check src tests scripts package.json tsconfig.json",
    "demo": "bun run build:runtime && bun src/demo.ts",
    "build": "bun scripts/build.ts",
    "desktop": "bun run build && electron .",
    "package:mac": "bun run build && bun scripts/package.ts",
    "build:runtime": "bun scripts/build-runtime.ts"
  },
  "dependencies": {
    "@deepseek-ai/dsh-agent": "0.1.2-rc.1",
    "@deepseek-ai/dsh-agent-loop": "0.1.2-rc.1",
    "@deepseek-ai/dsh-llm": "0.1.2-rc.1",
    "@deepseek-ai/dsh-session": "0.1.2-rc.1",
    "@deepseek-ai/dsh-session-projection": "0.1.2-rc.1",
    "@deepseek-ai/dsh-session-persistence-jsonl": "0.1.2-rc.1",
    "@deepseek-ai/dsh-attachment-local": "0.1.2-rc.1",
    "@deepseek-ai/dsh-tools": "0.1.2-rc.1",
    "@deepseek-ai/dsh-system-prompt": "0.1.2-rc.1",
    "@deepseek-ai/dsh-subagent": "0.1.2-rc.1",
    "@deepseek-ai/dsh-subagent-spawn-in-process": "0.1.2-rc.1",
    "@deepseek-ai/cordis": "4.0.2",
    "@google/genai": "2.21.0",
    "react": "19.2.0",
    "react-dom": "19.2.0"
  },
  "devDependencies": {
    "typescript": "^5.9.3",
    "@types/bun": "^1.3.0",
    "prettier": "3.6.2",
    "electron": "44.1.1",
    "@electron/packager": "20.3.0",
    "esbuild": "0.25.12",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0",
    "bun": ">=1.3.14"
  },
  "main": "dist/desktop/main.mjs",
  "productName": "Proactive Lab",
  "trustedDependencies": [
    "electron"
  ]
}
